generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String            @db.VarChar(255)
  email        String            @unique @db.VarChar(255)
  passwordHash String            @map("password_hash") @db.VarChar(255)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  sessions     ExerciseSession[]
  reminders    Reminder[]

  @@map("users")
}

model ExerciseSession {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  startTime            DateTime     @map("start_time") @db.Timestamptz
  endTime              DateTime     @map("end_time") @db.Timestamptz
  durationSeconds      Int          @map("duration_seconds")
  maxPressureAchieved  Decimal      @map("max_pressure_achieved") @db.Decimal(10, 2)
  maxLevelReached      Int          @map("max_level_reached")
  maxLevelHoldDuration Int          @map("max_level_hold_duration")
  numberOfRepetitions  Int          @default(0) @map("number_of_repetitions")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz
  
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repetitions          Repetition[]

  @@map("exercise_sessions")
}

model Repetition {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String          @map("session_id") @db.Uuid
  timestamp    DateTime        @default(now()) @db.Timestamptz
  maxPressure  Decimal         @map("max_pressure") @db.Decimal(10, 2)
  levelReached Int             @map("level_reached")
  holdDuration Int             @map("hold_duration")
  
  session      ExerciseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("repetitions")
}

/// A breathing-exercise reminder emailed to the user at a local time on chosen weekdays.
model Reminder {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// Local time in the user's timezone, 24-hour clock.
  hour       Int
  minute     Int
  /// Weekdays it fires on: 0 = Sunday ... 6 = Saturday.
  days       Int[]
  /// IANA timezone the time is in, e.g. "Asia/Kolkata".
  timezone   String   @db.VarChar(64)
  enabled    Boolean  @default(true)
  /// Local date (YYYY-MM-DD) of the last email sent, so a reminder fires at most once a day.
  lastSentOn String?  @map("last_sent_on") @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reminders")
}
