generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String            @db.VarChar(255)
  email        String            @unique @db.VarChar(255)
  passwordHash String            @map("password_hash") @db.VarChar(255)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  sessions     ExerciseSession[]

  @@map("users")
}

model ExerciseSession {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  startTime            DateTime     @map("start_time") @db.Timestamptz
  endTime              DateTime     @map("end_time") @db.Timestamptz
  durationSeconds      Int          @map("duration_seconds")
  maxPressureAchieved  Decimal      @map("max_pressure_achieved") @db.Decimal(10, 2)
  maxLevelReached      Int          @map("max_level_reached")
  maxLevelHoldDuration Int          @map("max_level_hold_duration")
  numberOfRepetitions  Int          @default(0) @map("number_of_repetitions")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz
  
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repetitions          Repetition[]

  @@map("exercise_sessions")
}

model Repetition {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String          @map("session_id") @db.Uuid
  timestamp    DateTime        @default(now()) @db.Timestamptz
  maxPressure  Decimal         @map("max_pressure") @db.Decimal(10, 2)
  levelReached Int             @map("level_reached")
  holdDuration Int             @map("hold_duration")
  
  session      ExerciseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("repetitions")
}
